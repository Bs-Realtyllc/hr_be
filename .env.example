# Copy to .env and fill in. Variables marked REQUIRED stop the server from
# starting if missing (see REQUIRED_ENV in index.ts). Everything else is
# optional: leaving it blank disables that integration or uses the default shown.

# ── Server ────────────────────────────────────────────────────────────────
PORT=6002
# production → auth cookies are sent with the Secure flag
NODE_ENV=development
# CORS origin; also used in links inside emails. Unset = reflect any origin.
FRONTEND_URL=http://localhost:5173
# Public base URL of this API (incl. /api), used to build signed file/media links.
# Unset = derived from the incoming request host.
API_BASE_URL=http://localhost:6002/api
# IANA timezone for Google Calendar events
APP_TIMEZONE=UTC

# ── MySQL (REQUIRED) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hr_platform
# Optional: connect via unix socket instead of host/port
DB_SOCKET_PATH=

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────
JWT_SECRET=change-me
# 64-char hex (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=

# ── MongoDB (inbox messages) ──────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hr_inbox

# ── MinIO (inbox audio storage; startup continues if unreachable) ─────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_AUDIO_BUCKET=inbox-audio

# ── Mail (SMTP) ───────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
# Sender address; defaults to MAIL_USER
MAIL_FROM=

# ── Google Calendar ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:6002/api/google/callback
# Public base URL Google can reach; /api/google/webhook is appended.
# Unset = push-notification channel is not registered.
GOOGLE_WEBHOOK_URL=

# ── Discord ───────────────────────────────────────────────────────────────
# Verifies Discord interaction signatures
DISCORD_PUBLIC_KEY=
# Standup bot endpoint + shared token for bot <-> backend calls
DISCORD_BOT_URL=
DISCORD_INTERNAL_TOKEN=

# ── Webhooks / n8n ────────────────────────────────────────────────────────
# Shared secret for HMAC-signed requests (requireHmac middleware + outgoing n8n calls)
HMAC_SECRET=
# Secret expected by the month-end trigger endpoint
WEBHOOK_TRIGGER_SECRET=
# n8n base URL; /month-end-trigger is appended
WEBHOOK_URL_N8N=

# ── LiveKit (inbox calls) ─────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
